pipeline {
    agent { label 'docker' }

    options {
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
    PROJECT_DIR = 'domain-monitoring-system'

    BACKEND_IMAGE = "domain-monitoring-backend:${BUILD_NUMBER}"
    FRONTEND_IMAGE = "domain-monitoring-frontend:${BUILD_NUMBER}"
    SELENIUM_IMAGE = "domain-monitoring-selenium:${BUILD_NUMBER}"

    BACKEND_CONTAINER = "dms-backend-${BUILD_NUMBER}"
    FRONTEND_CONTAINER = "dms-frontend-${BUILD_NUMBER}"
    SELENIUM_CONTAINER = "dms-selenium-${BUILD_NUMBER}"

    CI_NETWORK = "dms-ci-${BUILD_NUMBER}"
}

    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Git Clone') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build') {
    steps {
        dir("${PROJECT_DIR}") {
            sh '''
                docker build --pull \
                    -f backend/Dockerfile \
                    -t "$BACKEND_IMAGE" \
                    .

                docker build --pull \
                    -f frontend/Dockerfile \
                    -t "$FRONTEND_IMAGE" \
                    .

                docker build \
                    -f tests/Dockerfile.selenium \
                    -t "$SELENIUM_IMAGE" \
                    .
            '''
        }
    }
}

        stage('Docker Run') {
    steps {
        withCredentials([
            string(
                credentialsId: 'dms-secret-key',
                variable: 'SECRET_KEY'
            )
        ]) {
            sh '''
                docker network create "$CI_NETWORK"

                docker run -d \
                    --name "$BACKEND_CONTAINER" \
                    --network "$CI_NETWORK" \
                    --network-alias backend \
                    "$BACKEND_IMAGE"

                backend_healthy=false

                for attempt in $(seq 1 15); do
                    if docker exec "$BACKEND_CONTAINER" \
                        python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5001/health', timeout=3)"; then
                        backend_healthy=true
                        break
                    fi

                    sleep 2
                done

                if [ "$backend_healthy" != "true" ]; then
                    echo "Backend health check failed"
                    docker logs "$BACKEND_CONTAINER"
                    exit 1
                fi

                docker run -d \
                    --name "$FRONTEND_CONTAINER" \
                    --network "$CI_NETWORK" \
                    --network-alias monitoring-app \
                    --env SECRET_KEY \
                    --env BACKEND_URL=http://backend:5001 \
                    "$FRONTEND_IMAGE"

                frontend_healthy=false

                for attempt in $(seq 1 15); do
                    if docker exec "$FRONTEND_CONTAINER" \
                        python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health', timeout=3)"; then
                        frontend_healthy=true
                        break
                    fi

                    sleep 2
                done

                if [ "$frontend_healthy" != "true" ]; then
                    echo "Frontend health check failed"
                    docker logs "$FRONTEND_CONTAINER"
                    exit 1
                fi
            '''
        }
    }
}

        stage('Test') {
            steps {
                sh '''
                    docker run \
                        --name "$SELENIUM_CONTAINER" \
                        --network "$CI_NETWORK" \
                        "$SELENIUM_IMAGE"
                '''
            }
        }
    }

    post {
    always {
        sh '''
            echo "Backend logs:"
            docker logs "$BACKEND_CONTAINER" 2>/dev/null || true

            echo "Frontend logs:"
            docker logs "$FRONTEND_CONTAINER" 2>/dev/null || true

            docker rm -f \
                "$SELENIUM_CONTAINER" \
                "$FRONTEND_CONTAINER" \
                "$BACKEND_CONTAINER" \
                >/dev/null 2>&1 || true

            docker network rm \
                "$CI_NETWORK" \
                >/dev/null 2>&1 || true

            docker image rm \
                "$SELENIUM_IMAGE" \
                "$FRONTEND_IMAGE" \
                "$BACKEND_IMAGE" \
                >/dev/null 2>&1 || true
        '''

        deleteDir()
    }

    success {
        echo 'Backend, frontend and headless Selenium tests passed.'
    }

    failure {
        echo 'Pipeline failed. Review the failed stage and container logs.'
    }
}
}
